<%
let content = `
        <!-- /.hidden-sidebar -->

    <!-- page-title -->
    <section class="page-title centred p_relative" style="background: #FAFAFA; border-radius: 20px;">
        <div class="anim-icon">
            <div class="icon icons-1 float-bob-y" style="background-image: url(../assets/images/icons/title-icon-1.png);"></div>
            <div class="icon icons-2 float-bob-y" style="background-image: url(../assets/images/icons/title-icon-2.png);"></div>
        </div>
        <div class="container">
            <div class="content-box">
                <h2 class="title">Контакты</h2>
            </div>
        </div>
    </section>
    <!-- page-title end-->
    <!-- contact-->
    <section class="contact-style-three">
        <div class="auto-container">
            <div class="row clearfix">
                <div class="col-lg-6 col-md-12 col-sm-12 info-column">
                    <div class="contact-info mr_70">
                        <h3>Свяжитесь с нами!</h3>
                        <p>Вы можете позвонить нам по телефону и мы найдем оптимальное решение для достижения ваших бизнес-целей и поможем вывести компанию на новый уровень.</p>
                        <div class="contact__info__block">
                            <div class="left__site__info">
                                <div class="contact__icon">
                                    <span class="icon-contact_phone_icon"></span>
                                </div>
                            </div>
                            <div class="right__site__info one">
                                <h5>Позвоните нам</h5>
                                <a href="tel:+7 962 703 3003">+7 962 703 3003</a>
                            </div>
                        </div>
                        <div class="contact__info__block">
                            <div class="left__site__info">
                                <div class="contact__icon">
                                    <span class="icon-contact_mail_icon"></span>
                                </div>
                            </div>
                            <div class="right__site__info two">
                                <h5>Электронная почта</h5>
                                <a href="mailto:info@yourmail.com">info@yourmail.com</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-md-12 col-sm-12 form-column">
                    <div class="form-inner">
                        <div class="contact___title">
                            <h3> Напишите нам! </h3>
                            <p>Для решения нестандартных задач и детального обсуждения проектов напишите на нашу почту. Мы внимательно изучим ваше предложение и подготовим персональный ответ в течение рабочего дня.</p>
                        </div>
                        <form id="contact-form">
                            <div class="row clearfix">
                                <div class="col-lg-6 col-md-6 col-sm-12 form-group">
                                    <input type="text" name="username" placeholder="Ваше имя" required>
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-12 form-group">
                                    <input type="email" name="email" placeholder="Ваша эл. почта" required>
                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 form-group">
                                    <input type="text" name="subject" placeholder="Услуга" required> <!-- изменил placeholder -->
                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 form-group">
                                    <textarea name="message" placeholder="Сообщение" required></textarea>
                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 form-group">
                                    <div class="check-box">
                                        <input class="check" type="checkbox" name="agree" id="checkbox" required>
                                        <label for="checkbox">Сохраните моё имя, адрес электронной почты и веб-сайт в этом браузере для следующего комментария. *</label>
                                    </div>
                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 form-group message-btn mr-0">
                                    <div class="more__buttons"> 
                                        <button class="btn-1" type="submit" name="submit-form">Отправить сообщение</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- contact end-->
       
    <!-- Map Section -->
    <section class="map-section">
        <div class="auto-container">
            <div class="location-map">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d55945.16225505631!2d-73.90847969206546!3d40.66490264739892!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c24fa5d33f083b%3A0xc80b8f06e177fe62!2sNew%20York%2C%20NY%2C%20USA!5e0!3m2!1sen!2sbd!4v1601263396347!5m2!1sen!2sbd" width="100%" height="469" frameborder="0" style="border:0; border-radius: 20px; width: 100%" allowfullscreen="" aria-hidden="false" tabindex="0"></iframe>
            </div>
        </div>
    </section>
    <!-- End Map Section -->
        <!-- main-footer -->
         `;
%>

<%- include('../layouts/main', {content: content}) %>